{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "$schema": "string",
    "projectId": {
      "type": "integer"
    },
    "templateName": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 30
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "inactive"
      ]
    }
  },
  "required": [
    "projectId",
    "templateName",
    "name",
    "status"
  ],
  "additionalProperties": false
}